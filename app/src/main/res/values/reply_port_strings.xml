<?xml version="1.0" encoding="utf-8"?>
<!--
  批次 2「评论域」新增文案（三层兜底 / 跨页状态同步）。

  单独一个文件而不是塞进 strings.xml：这一批与其它并行改动共用仓库，
  新键集中在这里能避免合并冲突；键名统一 reply_port_ 前缀，不与既有键碰撞。
-->
<resources>

    <!-- ==================== 三层兜底 ==================== -->
    <!-- 服务端拉取失败、但本地还留着自己刚发的评论时：先把本地评论显示出来，不摆一个空列表 -->
    <string name="reply_port_local_only">网络不太顺，先显示你刚发的评论</string>
    <!-- 换排序、换评论区类型都拿不到内容：明确告诉用户还能手动重试，而不是默默空着 -->
    <string name="reply_port_empty_retry">评论暂时刷不出来，下拉可以再试一次</string>

    <!-- ==================== 跨页状态同步 ==================== -->
    <!-- 本页的根评论在别的页面被删了：详情页只剩一堆没有根的楼中楼，给句话再退出 -->
    <string name="reply_port_deleted">这条评论已经被删除了</string>

</resources>
