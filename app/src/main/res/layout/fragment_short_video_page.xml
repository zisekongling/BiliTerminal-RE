<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <master.flame.danmaku.ui.widget.DanmakuView
        android:id="@+id/danmakuView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/bufferingIndicator"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/coverImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/playIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_media_play"
        android:visibility="gone"
        android:alpha="0.7" />

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#348A8A8A"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <com.RobinNotBad.BiliClient.ui.widget.MarqueeTextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/arrow_back"
            android:text="短视频"
            android:textColor="@color/textwhite"
            android:textSize="12sp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/bottom_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#348A8A8A"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <com.RobinNotBad.BiliClient.ui.widget.HighEnergyProgressBar
            android:id="@+id/videoprogress"
            style="@style/Widget.AppCompat.SeekBar"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:progressTint="#aa44aaff"
            android:secondaryProgressTint="#eeFEFEFE"
            android:thumb="@drawable/player_selector_progress"
            android:thumbOffset="8dp" />

        <TextView
            android:id="@+id/text_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:gravity="start"
            android:text="00:00/00:00"
            android:alpha="0.8"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <RelativeLayout
            android:id="@+id/bottom_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_quality"
                    android:layout_width="32dp"
                    android:layout_height="37dp"
                    android:layout_marginEnd="6dp"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_menu"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/button_sound_cut"
                    android:layout_width="32dp"
                    android:layout_height="37dp"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/soundcut" />

                <ImageButton
                    android:id="@+id/button_video"
                    android:layout_width="32dp"
                    android:layout_height="37dp"
                    android:layout_marginStart="6dp"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@drawable/btn_player_pause" />

                <ImageButton
                    android:id="@+id/button_sound_add"
                    android:layout_width="32dp"
                    android:layout_height="37dp"
                    android:layout_marginStart="6dp"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/soundadd" />

                <TextView
                    android:id="@+id/button_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="37dp"
                    android:layout_marginStart="6dp"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="1.0x"
                    android:textColor="#fff"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/button_danmaku"
                    android:layout_width="32dp"
                    android:layout_height="37dp"
                    android:layout_marginStart="6dp"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/danmakuon" />

                <ImageButton
                    android:id="@+id/button_page_selector"
                    android:layout_width="32dp"
                    android:layout_height="37dp"
                    android:layout_marginStart="6dp"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_folder"
                    android:visibility="gone" />
            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/showsound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:shadowColor="@color/bgblack"
        android:shadowDx="2.0"
        android:shadowDy="0.0"
        android:shadowRadius="3.0"
        android:text="音量：100%"
        android:textColor="#fff"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>