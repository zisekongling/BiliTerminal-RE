<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 默认中号二维码：0.15/0.85（见 QRLoginFragment.QrScale.MEDIUM） -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline33"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.15" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline34"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.85" />

            <!--
                宽度由左右两条 Guideline 决定（0dp = match constraint），高度靠 1:1 比例跟随宽度。
                注意不要用 wrap_content + adjustViewBounds：那样卡片会被二维码位图的固有尺寸
                撑成固定大小，Guideline 怎么改都不生效（登录页二维码缩放曾经的 bug）。
                加 width_max 兜住平板/横屏：正方形不会宽到把状态文字挤出屏幕。
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/qrImageBg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:cardBackgroundColor="@color/qr_plate"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@+id/guideline34"
                app:layout_constraintStart_toStartOf="@+id/guideline33"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="280dp">

                <ImageView
                    android:id="@+id/qrImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:contentDescription="登录二维码"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/loading_qr" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/scanStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="正在获取二维码"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/qrImageBg" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginModeSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical"
                android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scanStat">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/activity_padding_horizontal">

                    <TextView
                        android:id="@+id/modeSwitchBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="WEB端扫码登录"
                        android:textAlignment="textStart"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/helpIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:minWidth="@dimen/touch_min"
                        android:minHeight="@dimen/touch_min"
                        android:layout_marginStart="8dp"
                        android:padding="4dp"
                        android:src="@drawable/icon_help"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/switchAccount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical"
                android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/loginModeSwitch">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
                    android:gravity="center_vertical"
                    android:text="切换账号"
                    android:textAlignment="textStart"
                    android:textSize="13sp"
                    app:drawableEndCompat="@drawable/arrow_forward"
                    tools:ignore="RtlCompat" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/jump"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical"
                android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/switchAccount">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
                    android:gravity="center_vertical"
                    android:text="但是我拒绝"
                    android:textAlignment="textStart"
                    android:textSize="13sp"
                    app:drawableEndCompat="@drawable/arrow_forward"
                    tools:ignore="RtlCompat" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/special"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical"
                android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/jump">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
                    android:gravity="center_vertical"
                    android:text="其他设备导入"
                    android:textAlignment="textStart"
                    android:textSize="13sp"
                    app:drawableEndCompat="@drawable/arrow_forward"
                    tools:ignore="RtlCompat" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>