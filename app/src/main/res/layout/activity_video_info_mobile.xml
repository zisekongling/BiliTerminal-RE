<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_default"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_below="@id/top"
        android:background="#000000">

        <SurfaceView
            android:id="@+id/player_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <master.flame.danmaku.ui.widget.DanmakuView
            android:id="@+id/player_danmaku"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/player_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/player_loading_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/player_loading_text0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:shadowColor="@color/bgblack"
                android:shadowDx="2.0"
                android:shadowDy="0.0"
                android:shadowRadius="3.0"
                android:text="加载中"
                android:textAlignment="center"
                android:textColor="#DDDDDD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/player_loading_text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:shadowColor="@color/bgblack"
                android:shadowDx="2.0"
                android:shadowDy="0.0"
                android:shadowRadius="3.0"
                android:text="OwO"
                android:textAlignment="center"
                android:textColor="#DDDDDD"
                android:textSize="10sp" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/player_controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/player_bottom_bar"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_alignParentBottom="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:background="#80000000">

                <ImageView
                    android:id="@+id/player_play_btn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/btn_player_play"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/player_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#ffffff"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/player_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:progress="0"
                    android:max="100"
                    android:thumbTint="#ffffff"
                    android:progressTint="#ffffff"
                    android:progressBackgroundTint="#88ffffff" />

                <TextView
                    android:id="@+id/player_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#ffffff"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/player_fullscreen_btn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/icon_fullscreen"
                    android:visibility="visible" />

            </LinearLayout>

            <TextView
                android:id="@+id/player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@id/player_bottom_bar"
                android:padding="8dp"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:lines="1"
                android:shadowColor="@color/bgblack"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="3" />

        </RelativeLayout>

    </FrameLayout>

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/player_container"
        android:layout_above="@id/danmaku_input_panel"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tab_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/safe_space_mobile"
                android:background="?android:colorBackground">

                <TextView
                    android:id="@+id/tab_intro"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="简介"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:background="?android:attr/dividerVertical" />

                <TextView
                    android:id="@+id/tab_comment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="评论"
                    android:textSize="13sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:background="?android:attr/dividerVertical" />

                <ImageView
                    android:id="@+id/danmaku_toggle_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/icon_danmaku"
                    android:scaleType="centerInside"
                    android:alpha="0.6" />

                <TextView
                    android:id="@+id/danmaku_send_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text="点我发弹幕"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:alpha="0.3" />

            <FrameLayout
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:id="@+id/related_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/danmaku_input_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/safe_space_mobile"
        android:paddingVertical="8dp"
        android:background="?android:colorBackground"
        android:visibility="gone">

        <EditText
            android:id="@+id/danmaku_edit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_comment_input"
            android:hint="输入弹幕内容"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/danmaku_send_ok_btn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="发送"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageView
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top"
        android:src="@mipmap/loading_2233" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_back_to_top"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_above="@id/danmaku_input_panel"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/arrow_up"
        android:visibility="gone"
        android:scaleType="center"
        app:fabSize="mini"
        app:backgroundTint="?attr/colorSecondary"
        app:tint="?attr/colorOnSecondary" />

</RelativeLayout>