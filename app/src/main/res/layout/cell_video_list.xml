<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
    android:layout_marginVertical="@dimen/list_margin_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/card_padding"
        android:paddingVertical="8dp">

        <!-- 封面行改成 ConstraintLayout：原实现把 app:layout_constraintDimensionRatio 写在 LinearLayout 里，
             完全失效，行高因此由每张图自己的比例决定 —— 列表滚动时高度持续抖动（CLS）。
             现在封面固定 42% 宽 + 16:9，标题区吃剩余宽度。
             26.11.17 由 48% 收到 42%、标题降到 text_caption：手表上封面偏大、标题一行只放得下几个字
             （用户反馈 #208「推荐页封面和字体有点太大了，标题显示字数太少」）。 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:contentDescription="@null"
                android:id="@+id/img_cover"
                android:importantForAccessibility="no"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/placeholder"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.42" />

            <TextView
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/text_cellsettingtitle_01"
                android:textSize="@dimen/text_caption"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/img_cover"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 时长角标（26.11.25，控制台反馈 #303）：贴封面右下角，默认隐藏。
                 是否显示由 VideoCardHolder.showVideoCard 按「设置 → 界面与外观 → 卡片显示时长」
                 与这张卡有没有时长共同决定；holder 会被复用，显示与隐藏两支都要显式设置。 -->
            <TextView
                android:id="@+id/text_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_cover_duration"
                android:includeFontPadding="false"
                android:paddingHorizontal="3dp"
                android:paddingVertical="1dp"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/img_cover"
                app:layout_constraintEnd_toEndOf="@id/img_cover" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/extra_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_viewcount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/icon_play_12"
                android:singleLine="true"
                android:text="@string/text_cellvideolist_01"
                android:textSize="@dimen/text_caption" />

            <com.RobinNotBad.BiliClient.ui.widget.MarqueeTextView
                android:id="@+id/text_upname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:drawableStartCompat="@drawable/icon_person"
                android:singleLine="true"
                android:text="@string/text_celluplist_01"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
