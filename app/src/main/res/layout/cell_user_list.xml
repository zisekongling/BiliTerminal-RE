<?xml version="1.0" encoding="utf-8"?>
<!-- 优化：替换 MaterialCardView + ConstraintLayout 为单层 FrameLayout，减少布局嵌套和渲染开销 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
    android:layout_marginVertical="@dimen/list_margin_vertical"
    android:background="@drawable/bg_card_rounded"
    android:foreground="?attr/selectableItemBackground"
    android:clipToOutline="true"
    android:elevation="2dp"
    android:outlineProvider="background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:contentDescription="@null"
            android:id="@+id/userAvatar"
            android:importantForAccessibility="no"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:adjustViewBounds="true"
            android:src="@mipmap/akari"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 昵称与「互关」徽章同一行：徽章只在查看自己的关注/粉丝/分组列表时出现，
                 由 UserListAdapter 按 UserInfo.mutualFollow 每次 bind 重置显隐 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/userName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:text="NappuHidda" />

                <TextView
                    android:id="@+id/mutualBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:alpha="0.9"
                    android:text="@string/social_mutual_follow_badge"
                    android:textColor="?attr/colorAccent"
                    android:textSize="10sp"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/userDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="12sp"
                android:alpha="0.7"
                android:text="@string/text_celluserlist_01" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>