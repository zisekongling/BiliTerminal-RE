<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingHorizontal="@dimen/activity_padding_horizontal"
    android:foreground="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:contentDescription="@string/a11y_view_user"
        android:id="@+id/avatar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@id/pubdate"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@mipmap/akari" />

    <com.RobinNotBad.BiliClient.ui.widget.MarqueeTextView
        android:id="@+id/username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="1dp"
        android:singleLine="true"
        android:text="@string/text_cellcollectioninfo_02"
        app:layout_constraintBottom_toTopOf="@+id/pubdate"
        app:layout_constraintStart_toEndOf="@id/avatar"
        app:layout_constraintTop_toTopOf="@id/avatar" />

    <TextView
        android:id="@+id/pubdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="1dp"
        android:alpha="0.7"
        android:text="11-45-14"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/avatar"
        app:layout_constraintStart_toEndOf="@id/avatar"
        app:layout_constraintTop_toBottomOf="@id/username" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:text="@string/text_cellcollectioninfo_01"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/avatar"
        tools:ignore="TouchTargetSizeCheck" />

    <TextView
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:text="@string/text_celldynamic_03"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        tools:ignore="TouchTargetSizeCheck" />

    <LinearLayout
        android:id="@+id/extraCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/content">

        <include
            android:id="@+id/dynamic_child"
            layout="@layout/cell_dynamic_child"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/dynamic_video_extra"
            layout="@layout/cell_dynamic_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/dynamic_image_extra"
            layout="@layout/cell_dynamic_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/dynamic_article_extra"
            layout="@layout/cell_dynamic_article"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/dynamic_vote_extra"
            layout="@layout/cell_dynamic_vote"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dynamic_control"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/extraCard" />

    <TextView
        android:id="@+id/likes"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:textColor="?android:attr/textColorSecondary"
        android:text="514"
        android:alpha="0.7"
        android:textSize="14sp"
        app:drawableStartCompat="@drawable/icon_reply_like0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/extraCard" />


    <!-- 评论入口：0 条时显示「评论」，有评论时显示 万/亿 数字；点击进详情页的评论页。
         drawable 的尺寸在 DynamicHolder 里按 14dp 重设（icon_reply 的固有尺寸是 24dp，
         直接当 compound drawable 会比这一行的 20dp 高，导致图标被裁）。 -->
    <TextView
        android:id="@+id/item_dynamic_comment"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:alpha="0.7"
        android:gravity="center_vertical"
        android:text="@string/dynamic_port_comment_entry"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/likes"
        app:layout_constraintTop_toTopOf="@+id/likes" />

    <!-- MMP哪个B在代码里设置了点赞的颜色害得我排除半天色调不对的问题 -->
    <TextView
        android:id="@+id/item_dynamic_share"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center_vertical"
        android:text="@string/text_celldynamic_02"
        android:alpha="0.7"
        app:drawableStartCompat="@drawable/icon_share"
        app:layout_constraintStart_toEndOf="@+id/item_dynamic_comment"
        app:layout_constraintTop_toTopOf="@+id/likes"
        android:textSize="14sp" />

    <!-- MMP哪个B在代码里设置了点赞的颜色害得我排除半天色调不对的问题 -->
    <TextView
        android:id="@+id/item_dynamic_delete"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:gravity="center_vertical"
        android:textColor="?android:attr/textColorPrimary"
        android:text="@string/text_celldynamic_01"
        android:alpha="0.7"
        app:drawableStartCompat="@drawable/icon_delete"
        app:layout_constraintStart_toEndOf="@+id/item_dynamic_share"
        app:layout_constraintTop_toTopOf="@+id/likes"
        android:textSize="14sp" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="2dp"
        android:background="@color/list_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/likes" />

</androidx.constraintlayout.widget.ConstraintLayout>