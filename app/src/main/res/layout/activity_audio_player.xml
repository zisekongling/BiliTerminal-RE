<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a1a">

    <!-- 320x320 手表风格播放器 -->
    <FrameLayout
        android:id="@+id/watch_player"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:background="#000000"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <!-- 两页滑动容器 -->
        <HorizontalScrollView
            android:id="@+id/slider_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- 第1页：播放器界面 -->
                <LinearLayout
                    android:id="@+id/page_player"
                    android:layout_width="320dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- 歌曲信息 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/song_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="歌曲名称"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/top"
                                xmlns:app="http://schemas.android.com/apk/res-auto"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="6dp"
                                android:contentDescription="菜单"
                                android:src="@drawable/icon_menu"
                                app:tint="#AAAAAA" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/song_author"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="歌手"
                            android:textColor="#7a7a7a"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 主控制区：上一首 / 播放 / 下一首 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_prev"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="上一首"
                            android:padding="12dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_audio_prev" />

                        <ImageButton
                            android:id="@+id/btn_play_pause"
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:layout_marginHorizontal="20dp"
                            android:background="@drawable/bg_play_button"
                            android:contentDescription="播放/暂停"
                            android:padding="22dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/btn_player_play" />

                        <ImageButton
                            android:id="@+id/btn_next"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="下一首"
                            android:padding="12dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_audio_next" />
                    </LinearLayout>

                    <!-- 进度条 -->
                    <FrameLayout
                        android:id="@+id/progress_area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <SeekBar
                            android:id="@+id/seek_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="1000"
                            android:progressDrawable="@drawable/seekbar_audio_progress"
                            android:splitTrack="false"
                            android:thumb="@drawable/seekbar_audio_thumb"
                            android:thumbOffset="4dp" />
                    </FrameLayout>

                    <!-- 底部控制：收藏 / 音量 / 更多 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="4dp">

                        <ImageButton
                            android:id="@+id/btn_fav"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="收藏"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_audio_heart" />

                        <ImageButton
                            android:id="@+id/btn_mode"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="音量"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_audio_volume" />

                        <ImageButton
                            android:id="@+id/btn_download"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="更多"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_audio_more" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 第2页：歌词界面 -->
                <LinearLayout
                    android:id="@+id/page_lyric"
                    android:layout_width="320dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_audio_music"
                        android:drawablePadding="6dp"
                        android:paddingBottom="6dp"
                        android:text="歌词"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ScrollView
                        android:id="@+id/lyric_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/lyric_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="4dp"
                            android:paddingBottom="20dp" />
                    </ScrollView>
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 页面指示器 -->
        <LinearLayout
            android:id="@+id/page_indicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/indicator_0"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/bg_page_indicator_active" />

            <View
                android:id="@+id/indicator_1"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/bg_page_indicator" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
