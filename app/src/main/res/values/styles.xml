<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 卡片/按钮圆角统一取 @dimen/card_round（真源在 dimens.xml，宽屏由 values-w300dp 覆盖）。

         为什么圆角**不用**主题属性做运行时切换：曾试过
         `<item name="cardCornerRadius">?attr/appCornerRadius</item>` + `theme.applyStyle(覆盖样式)`，
         真机实测半径变成 **0**（卡片角完全未裁，连原来的 6/10dp 都丢了）——
         维度属性的 `?attr/` 间接层在这里没有解析成功。改用运行时套用，
         见 `ui/appearance/CornerRadius.kt`：默认「方角」直接用这里的 dimen 值、零开销；
         选「圆角」时才在 `BaseActivity.onContentChanged()` 里套一次 `card_round_large`。 -->

    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="rippleColor" tools:ignore="PrivateResource">@color/bili_secondary</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="cardBackgroundColor">@color/card_dark</item>
        <item name="cardCornerRadius">@dimen/card_round</item>
        <item name="cardElevation">4dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="strokeColor">@color/divider_dark</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="CardStyleLight" parent="Widget.MaterialComponents.CardView">
        <item name="rippleColor" tools:ignore="PrivateResource">@color/bili_secondary</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="cardBackgroundColor">@color/card_light</item>
        <item name="cardCornerRadius">@dimen/card_round</item>
        <item name="cardElevation">2dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="strokeColor">@color/divider_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!--
        按钮公共基线样式：所有主题的 ButtonStyle* / 玻璃变体都继承它。
        手表屏只有 200dp 出头，两个按钮各占一半时内容区只有 70dp 上下；放 5～6 个汉字
        的系统字体一放大就会折行。折行后同一行两个按钮高度不同，LinearLayout 默认的
        基线对齐还会把较矮那个上下错开——用户看到的就是「按钮对不齐、界面崩坏」。
        这里统一成：文字永远单行，放不下时自动缩小字号（7sp～14sp），不折行也不裁字。
        autoSize* 是 AppCompat 的自动字号能力，API 19 起由 appcompat 兼容实现。
        显式写死字号的小按钮（如 WebView 缩放键）在各自布局里用 autoSizeTextType=none 关掉。
    -->
    <style name="ButtonStyleBase" parent="Widget.MaterialComponents.Button">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">7sp</item>
        <item name="autoSizeMaxTextSize">14sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <style name="ButtonStyle" parent="ButtonStyleBase">
        <item name="backgroundTint">@color/pink</item>
        <item name="cornerRadius">@dimen/card_round</item>
        <item name="android:textColor">@color/pink_btn_text</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="elevation">2dp</item>
        <item name="rippleColor">@color/bili_primary_light</item>
    </style>

    <style name="ButtonStyleLight" parent="ButtonStyleBase">
        <item name="backgroundTint">@color/pink</item>
        <item name="cornerRadius">@dimen/card_round</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="elevation">2dp</item>
        <item name="rippleColor">@color/bili_primary_light</item>
    </style>

    <style name="EditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:textColorHighlight">@color/text_selection_highlight</item>
        <item name="android:textColorHint">@color/text_tertiary_dark</item>
        <item name="android:textCursorDrawable">@drawable/cursor_drawable</item>
        <item name="android:textColor">@color/text_primary_dark</item>
    </style>

    <style name="EditTextStyleLight" parent="Widget.AppCompat.EditText">
        <item name="android:textColorHighlight">@color/text_selection_highlight</item>
        <item name="android:textColorHint">@color/text_tertiary_light</item>
        <item name="android:textCursorDrawable">@drawable/cursor_drawable</item>
        <item name="android:textColor">@color/text_primary_light</item>
    </style>

    <style name="SwitchCompatStyle" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:background">@drawable/background_edittext_setting</item>
        <item name="android:textColor">@color/text_primary_dark</item>
    </style>

    <style name="SwitchCompatStyleLight" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:textColor">@color/text_primary_light</item>
    </style>

    <style name="RadioButtonStyle" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:minHeight">10dp</item>
    </style>

    <style name="ListStyle">
        <item name="android:descendantFocusability">afterDescendants</item>
    </style>

    <style name="TextViewStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextViewStyleLight" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 分段条页签的文字样式：TabLayout 没有 tabTextSize 这个属性（只有 tabTextAppearance），
         而这条横条要和其他排序/筛选条保持一致的字号，所以包一层 TextAppearance。 -->
    <style name="TextAppearance.ReBili.SegmentedTab" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>