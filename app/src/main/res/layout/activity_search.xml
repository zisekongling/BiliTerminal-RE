<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.search.SearchActivity">


    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top" />

    <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
        android:id="@+id/history_recyclerview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
        android:layout_marginVertical="3dp"
        android:paddingVertical="2dp"
        android:background="@drawable/background_searchhistory"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchbar"
        tools:itemCount="4"
        tools:listitem="@layout/cell_choose" />

    <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
        android:id="@+id/suggestions_recyclerview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
        android:layout_marginVertical="3dp"
        android:paddingVertical="2dp"
        android:background="@drawable/background_searchhistory"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchbar"
        tools:itemCount="4"
        tools:listitem="@layout/cell_choose" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/searchbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top">

        <EditText
            android:id="@+id/keywordInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/background_searchbar"
            android:drawableEnd="@drawable/icon_search"
            android:ems="10"
            android:hint="@string/hint_search"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:minHeight="42dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 搜索结果排序入口：搜索框最左边的图标按钮，只有支持 order 参数分类（视频 / 专栏）
             且已经搜过一次时才显示。它是搜索框的一部分（压在输入框左侧），不再单独占一行——
             26.10.24 那一版是搜索框下面一条全宽「排序：综合」按钮，26.10.26 改成本图标。

             图标是 `drawable/icon_sort_filter.xml`（Material Symbols tune，26.11.08 由用户给的 SVG 换掉
             原来的 `drawable-nodpi/icon_sort_filter.png`）；它靠 tint 取色，暗色 / 亮色共用一份，
             所以两种模式下都看得见（早先那张 PNG 是写死暖白，亮色下几乎不可见）。
             左边留给它的内边距由 `SearchActivity.applySortIconVisible` 动态改输入框的 paddingStart，
             收起时输入框恢复 XML 里的 8dp。 -->
        <ImageView
            android:id="@+id/searchSortButton"
            android:layout_width="30dp"
            android:layout_height="0dp"
            android:layout_marginStart="3dp"
            android:contentDescription="@string/text_search_sort_title"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_sort_filter"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/keywordInput"
            app:layout_constraintStart_toStartOf="@+id/keywordInput"
            app:layout_constraintTop_toTopOf="@+id/keywordInput"
            tools:visibility="visible" />

        <View
            android:id="@+id/search"
            android:layout_width="35dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/keywordInput"
            app:layout_constraintEnd_toEndOf="@+id/keywordInput"
            app:layout_constraintTop_toTopOf="@+id/keywordInput" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginVertical="3dp"
            android:text="@string/pagename_search"
            android:textStyle="bold"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            app:drawableStartCompat="@drawable/arrow_down" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <TextView
        android:id="@+id/text_tutorial_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/top"
        android:background="#6000"
        android:clickable="false"
        android:gravity="center"
        android:text="@string/tutorial_pager"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top" />

</androidx.constraintlayout.widget.ConstraintLayout>