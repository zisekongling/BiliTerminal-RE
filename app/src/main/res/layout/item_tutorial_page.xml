<?xml version="1.0" encoding="utf-8"?>
<!--
  教程内部分页的单页模板。
  外层 ViewPager2 负责左右翻页，内层 RotaryScrollView 负责内容过长时的垂直滚动与旋冠滚动。
-->
<com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/activity_padding_horizontal">

        <TextView
            android:id="@+id/page_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="14sp" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/page_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:adjustViewBounds="true"
            android:visibility="gone"
            app:round="@dimen/card_round" />
    </LinearLayout>
</com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>
