<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 宽屏（手机/平板，可用宽度 ≥ 300dp）覆盖：手表基准值在这里放大一档。
         手表可用宽度约 200~250dp，不会命中这组覆盖。 -->
    <dimen name="text_topbar">15sp</dimen>
    <dimen name="text_title">16sp</dimen>
    <dimen name="text_subtitle">14sp</dimen>
    <dimen name="text_body">13sp</dimen>
    <dimen name="text_caption">12sp</dimen>

    <dimen name="card_padding">12dp</dimen>
    <dimen name="card_padding_horizontal">16dp</dimen>

    <dimen name="topbar_height">36dp</dimen>

    <dimen name="activity_padding_horizontal">8dp</dimen>
    <dimen name="list_margin_vertical">3dp</dimen>

    <!-- 圆角**不在宽屏放大**：原项目 BiliClient 只有一个 values/ 目录、card_round 全局 6dp，
         宽屏放大是本项目后加的，会让手机上的「方角」看起来仍然是圆的（实测 10dp≈27px），
         与设置项语义冲突。故 card_round / card_round_large 全平台统一，只在 values/ 定义。 -->
</resources>
