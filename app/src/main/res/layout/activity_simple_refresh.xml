<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_default"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <!-- 列表区 + 底部"正在加载…／没有更多了"状态条。
         刻意不用 ConcatAdapter 把状态条做成列表项：那会重映射业务 adapter 的 viewType
         （SettingsAdapter 等使用负数 viewType 的 adapter 会错配 Holder 而崩），也会改变
         adapterPosition 语义。放在列表外最安全。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top"
        android:orientation="vertical">

        <!-- 列表筛选条：默认隐藏，只有需要分类的页面（如「稍后再看」的 全部/未看完）才在代码里
             设成 VISIBLE 并接管点击。和 loadMoreTip 一样放在列表外，避免改变业务 adapter 的
             viewType 或 adapterPosition 语义。 -->
        <LinearLayout
            android:id="@+id/filterBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingVertical="2dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="@dimen/touch_min"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/uitext_dynamicadapter_001"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/filterUnfinished"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="@dimen/touch_min"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/text_activitysimplerefresh_05"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- 「清除所有已看完」：只有「稍后再看」页会点亮（其它页面 findViewById 取到即为 gone）。
                 破坏性操作，点击后仍要走 TerminalDialog.confirm 二次确认。 -->
            <TextView
                android:id="@+id/clearWatched"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="@dimen/touch_min"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/text_activitysimplerefresh_04"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- 排序条：同样默认隐藏，只有收藏夹内容页（C19 的 收藏时间/播放量/投稿时间）在代码里点亮。
             排序要重发请求，所以它和上方的筛选条是两回事（筛选是纯本地过滤）。 -->
        <LinearLayout
            android:id="@+id/sortBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingVertical="2dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/sortFavTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="@dimen/touch_min"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/text_activitysimplerefresh_03"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/sortView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="@dimen/touch_min"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/text_activitycreativecenter_08"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/sortPubtime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="@dimen/touch_min"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/text_activitysimplerefresh_02"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <!-- 多选条：同样默认隐藏，只有收藏夹内容页在能写（自己的收藏夹 + 有 media_id）时才点亮。
             「多选」进出多选模式，「删除(n)」把选中的条目一次从收藏夹里移除。 -->
        <LinearLayout
            android:id="@+id/manageBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingVertical="2dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/manageToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="@dimen/touch_min"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/uitext_favoritevideolistactivity_009"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/manageDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="@dimen/touch_min"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/settingtext_accountswitchactivity_003"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <!-- 分组管理条：同样默认隐藏，只有关注列表的「分组模式」（自己的关注 + 设置开关打开）才点亮。
             一个「+ 新建分组」按钮；改名/删除走分组标题的长按菜单。 -->
        <LinearLayout
            android:id="@+id/groupBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingVertical="2dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/groupCreate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="@dimen/touch_min"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/text_activitysimplerefresh_01"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <!-- 订阅条：默认隐藏。别人的收藏夹内容页 / 视频合集详情页才会点亮，
             一个按钮在「订阅 / 已订阅（点击取消）」之间切换。自己的内容不显示。 -->
        <LinearLayout
            android:id="@+id/subBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingVertical="2dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/subToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="@dimen/touch_min"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/text_sub_toggle_subscribe"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/loadMoreTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone"
            tools:text="正在加载…" />

    </LinearLayout>

    <!-- 空态：列表为空是正常状态（下载列表/收藏/历史/关注等），不放 loading_2233_error
         报错插画，否则会被误认成"加载失败"。确属加载失败时由 MsgUtil.err 弹提示。

         必须 layout_below="@id/top"，不能从屏幕顶端铺满：它在布局里排在 top 之后，
         RelativeLayout 会把它画在顶栏上面，而点击命中也是从后往前派发的。以前它盖住整页，
         `setOnEmptyRetry` 一给它装监听器就变成「顶栏那一块也归它」，于是点顶栏不退出、
         而是在原地重拉列表 —— 「我的反馈」空态点顶栏变刷新就是这个（26.11.02 用户反馈）。
         其余页面的空态虽然没装点击监听器、点顶栏能穿透到 top，但顶栏同样被文字压住，
         一并收进 top 下方。 -->
    <TextView
        android:id="@+id/emptyTip"
        android:padding="@dimen/space_xl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top"
        android:gravity="center"
        android:text="@string/text_list_empty"
        android:textAlignment="center"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

</RelativeLayout>
