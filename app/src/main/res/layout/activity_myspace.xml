<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.user.MySpaceActivity">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_myspace"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <!-- 26.11.13 视觉统一：本页改为和「菜单排序」页同一套行样式——左右 6dp 外边距
                 由各行自己带（cell_myspace_item 的 marginHorizontal），容器不再加横向 padding，
                 也不再用 showDividers 隔行（行自带 2dp 上下 margin，行间合计 4dp）。
                 这张用户卡没有行样式，所以横向 6dp 与下方 2dp 由它自己给：
                 2dp + 首行的 2dp = 4dp，和行间距一致。
                 挂在 myinfo 的 marginBottom 而非 menuContainer 的 marginTop：MySpaceMoreActivity
                 复用本布局并把 myinfo 置为 GONE，GONE 视图的 margin 不参与测量，
                 「更多」页因此不会平白多出间距。详见 docs/review/fix-progress.md §3.22 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/myinfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
                android:layout_marginBottom="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginVertical="8dp">

                    <ImageView
                        android:contentDescription="@null"
                        android:id="@+id/userAvatar"
                        android:importantForAccessibility="no"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:adjustViewBounds="true"
                        android:src="@mipmap/akari"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.RobinNotBad.BiliClient.ui.widget.MarqueeTextView
                        android:id="@+id/userName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="1dp"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:text="@string/text_activitymyspace_01"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toTopOf="@+id/userFans"
                        app:layout_constraintStart_toEndOf="@id/userAvatar"
                        app:layout_constraintTop_toTopOf="@id/userAvatar" />

                    <TextView
                        android:id="@+id/userFans"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="-1dp"
                        android:alpha="0.7"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@id/userAvatar"
                        app:layout_constraintTop_toBottomOf="@id/userName" />

                    <TextView
                        android:id="@+id/userExp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="-3dp"
                        android:alpha="0.7"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="11sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/userAvatar"
                        app:layout_constraintTop_toBottomOf="@id/userFans" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/menuContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>

</RelativeLayout>
