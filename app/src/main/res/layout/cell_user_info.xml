<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingHorizontal="@dimen/activity_padding_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/userAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/akari"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.RobinNotBad.BiliClient.ui.widget.MarqueeTextView
        android:id="@+id/userName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:text="@string/text_cellcollectioninfo_02"
        app:layout_constraintBottom_toTopOf="@+id/userLevel"
        app:layout_constraintStart_toEndOf="@id/userAvatar"
        app:layout_constraintTop_toTopOf="@id/userAvatar" />

    <TextView
        android:id="@+id/userLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="2dp"
        android:alpha="0.86"
        tools:text="Lv114"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/userAvatar"
        app:layout_constraintStart_toEndOf="@id/userAvatar"
        app:layout_constraintTop_toBottomOf="@+id/userName" />

    <TextView
        android:id="@+id/userFollowers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="5dp"
        android:alpha="0.7"
        android:text="@string/text_celluserinfo_09"
        android:textColor="?attr/colorAccent"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@+id/userDesc"
        app:layout_constraintStart_toStartOf="@id/userDesc"
        app:layout_constraintTop_toBottomOf="@+id/userAvatar" />

    <TextView
        android:id="@+id/userMedal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:alpha="0.7"
        android:text="@string/text_celluserinfo_08"
        android:textSize="12sp"
        android:textColor="?attr/colorAccent"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="@+id/userFollowers"
        app:layout_constraintStart_toEndOf="@id/userFollowers"
        app:layout_constraintTop_toTopOf="@+id/userFollowers" />

    <View
        android:id="@+id/medalDivider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginStart="5dp"
        android:background="@color/list_divider"
        app:layout_constraintBottom_toBottomOf="@id/userFollowers"
        app:layout_constraintStart_toEndOf="@id/userMedal"
        app:layout_constraintTop_toTopOf="@id/userFollowers" />

    <TextView
        android:id="@+id/userFollowings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:alpha="0.7"
        android:text="@string/text_celluserinfo_07"
        android:textSize="12sp"
        android:textColor="?attr/colorAccent"
        app:layout_constraintBottom_toBottomOf="@+id/userFollowers"
        app:layout_constraintStart_toEndOf="@id/medalDivider"
        app:layout_constraintTop_toTopOf="@+id/userFollowers" />

    <TextView
        android:id="@+id/userDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/text_cellcollectioninfo_01"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/userFollowers"
        tools:ignore="TouchTargetSizeCheck" />

    <!-- 性别 / IP 属地（批次 1）：两项都拿不到时整行 GONE，由 UserInfoApi.buildGenderIpLine 返回空串决定。
         默认 gone 是刻意的：老调用方还没接时不能凭空多出一行空白。 -->
    <TextView
        android:id="@+id/userGenderIp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.7"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/userDesc"
        tools:text="性别：男 · IP属地：上海" />

    <TextView
        android:id="@+id/userNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.7"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/text_celluserinfo_06"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/userGenderIp"
        tools:ignore="TouchTargetSizeCheck" />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/liveRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="2dp"
        android:alpha="0.78"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/userNotice">

        <TextView
            android:id="@+id/liveRoomLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:textColor="?attr/colorPrimary"
            android:text="@string/text_celluserinfo_05"
            android:textAlignment="textStart"
            android:textSize="13sp"
            app:drawableRightCompat="@drawable/arrow_forward"
            tools:ignore="RtlCompat" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/exclusiveTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="2dp"
        android:alpha="0.78"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/liveRoom">

        <TextView
            android:id="@+id/exclusiveTipLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:text="@string/text_celluserinfo_04"
            android:textAlignment="textStart"
            android:textSize="13sp"
            tools:ignore="RtlCompat" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/electricPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="2dp"
        android:alpha="0.78"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/exclusiveTip">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/electricPanelHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:text="@string/text_celluserinfo_03"
                android:textAlignment="textStart"
                android:textSize="13sp"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/arrow_down"
                tools:ignore="RtlCompat" />

            <View
                android:id="@+id/electricPanelDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/list_divider"
                android:visibility="gone" />

            <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                android:id="@+id/electricUserList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/officialIcon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:adjustViewBounds="true"
        android:alpha="0.5"
        android:src="@mipmap/icon_verified"
        app:layout_constraintBottom_toBottomOf="@id/userOfficial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/userOfficial" />

    <TextView
        android:id="@+id/userOfficial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.6"
        android:text="@string/text_celluserinfo_02"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/officialIcon"
        app:layout_constraintTop_toBottomOf="@id/electricPanel" />

    <ImageView
        android:id="@+id/uidIcon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:adjustViewBounds="true"
        android:alpha="0.5"
        android:src="@drawable/icon_uid"
        app:layout_constraintBottom_toBottomOf="@id/uidText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/uidText" />

    <TextView
        android:id="@+id/uidText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.6"
        android:text="1234567"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/uidIcon"
        app:layout_constraintTop_toBottomOf="@id/userOfficial" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/followBtn"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:insetTop="0dp"
        app:strokeWidth="0dp"
        android:insetBottom="0dp"
        android:layout_marginEnd="2dp"
        android:backgroundTint="?attr/secondaryButtonTint"
        android:text="@string/uitext_myspacemenu_001"
        app:layout_constraintEnd_toStartOf="@+id/msgBtn"
        app:layout_constraintStart_toStartOf="@+id/userDesc"
        app:layout_constraintTop_toBottomOf="@+id/uidText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/msgBtn"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginStart="2dp"
        app:strokeWidth="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:backgroundTint="?attr/secondaryButtonTint"
        android:text="@string/pagename_private_message"
        app:layout_constraintEnd_toEndOf="@+id/userDesc"
        app:layout_constraintStart_toEndOf="@id/followBtn"
        app:layout_constraintTop_toTopOf="@id/followBtn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/contractBtn"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        app:strokeWidth="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:backgroundTint="?attr/secondaryButtonTint"
        android:text="@string/text_celluserinfo_01"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/userDesc"
        app:layout_constraintStart_toStartOf="@+id/userDesc"
        app:layout_constraintTop_toBottomOf="@id/followBtn" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="4dp"
        android:background="@color/list_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/followBtn" />

</androidx.constraintlayout.widget.ConstraintLayout>