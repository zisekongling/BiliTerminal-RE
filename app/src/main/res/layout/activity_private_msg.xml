<?xml version="1.0" encoding="utf-8"?>
<!--
  顶栏不铺底色、列表排在顶栏下方（而不是全屏列表 + 不透明顶栏盖在上面）：
  原先的 ?android:attr/colorBackground 在开启弥散光晕时会把顶部最亮的那块光晕盖成一条纯色横带，
  而且经典终端下它取主题 XML 的 #1B1B24，与运行时背景 #000000 本就不一致。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent">

    <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
        android:id="@+id/msg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="40dp" />

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_private_message"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>


    <!--
      输入行刻意用横向 LinearLayout + 权重，而不是 RelativeLayout + layout_toStartOf：
      RelativeLayout 里 match_parent 的子 View 仍按整行宽度量，layout_toStartOf 只改右边缘位置，
      输入框并没有缩成「三个按钮左侧的剩余宽度」——文字区域和按钮重叠（按钮后声明、画在上层），
      提示语与刚打的字被右侧那三个 38dp 图标压住看不见（反馈 #157）。权重方案的宽度就是「整行 − 三个按钮」，
      输入框不再伸到按钮底下，换行也按真实可用宽度算。
    -->
    <LinearLayout
        android:id="@+id/layout_input"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/msg_input_et"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/background_edittext_privatemsg"
            android:hint="@string/hint_private_message"
            android:maxHeight="128dp"
            android:minHeight="38dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp"
            android:textColorHint="@color/hint_on_bg"
            android:textSize="13sp"
            android:inputType="textMultiLine" />

        <ImageButton
            android:id="@+id/emote_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/background_privatemsg_send"
            android:contentDescription="@string/social_emote_button_desc"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/icon_emote" />

        <TextView
            android:id="@+id/image_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/background_privatemsg_send"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/text_activityprivatemsg_01"
            android:textColor="#ffffff"
            android:textSize="15sp" />

        <ImageButton
            android:contentDescription="@string/btn_send"
            android:id="@+id/send_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/background_privatemsg_send"
            app:srcCompat="@drawable/send" />

    </LinearLayout>
</RelativeLayout>
