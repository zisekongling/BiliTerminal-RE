<?xml version="1.0" encoding="utf-8"?>
<!--
  SponsorBlock（第三方广告片段标注）相关文案。

  与 player_s_port_strings.xml 同样的约定：只放本批新增的字符串，`strings.xml` 由主线维护，
  本批不碰，避免和并发改动冲突。命名统一 player_sb_ 前缀（sb = SponsorBlock）。
-->
<resources>
    <!-- 设置项：跳过档位（0=关 / 1=仅广告 / 2=+自我推广 / 3=推荐 / 4=全部 / 5=自定义） -->
    <string name="player_sb_mode_name">跳过广告片段（SponsorBlock）</string>
    <string name="player_sb_mode_desc">由观众标注的广告/推广片段，播放时自动跳过。数据来自第三方服务 BilibiliSponsorBlock，不是 B 站官方数据；跳过后面板会给出「撤回」</string>
    <string name="player_sb_mode_off">关闭</string>
    <string name="player_sb_mode_ad">仅恰饭广告</string>
    <string name="player_sb_mode_promo">广告+自我推广</string>
    <string name="player_sb_mode_recommended">推荐</string>
    <string name="player_sb_mode_all">全部类别</string>
    <string name="player_sb_mode_custom">自定义</string>

    <!-- 设置分组标题：把「番剧片头片尾」和「投稿广告」两条跳过放在一组 -->
    <string name="setting_player_group_skip">自动跳过</string>

    <!-- 自定义档的类别勾选页 -->
    <string name="player_sb_cat_page_name">要跳的类别</string>
    <string name="player_sb_cat_page_desc">逐项勾选要自动跳过的类别；勾选后档位会自动切到「自定义」</string>
    <string name="player_sb_cat_page_note">精彩时刻是跳转点（不是一段广告），不进这个页面、任何档位都不会跳——播放页的「看点」里能直接跳过去；静音型本版不处理。整段视频标签（整片都是广告这类）没有可跳的区间，只会在播放页顶栏标题前挂一个标记。</string>
    <string name="player_sb_cat_filler_desc">离题闲聊属主观判断，建议自己看过再决定</string>
    <string name="player_sb_cat_music_offtopic_desc">MV / 翻唱里的谈话段</string>

    <!-- 类别中文名（与 SponsorSkipPolicy 里的 category id 一一对应） -->
    <string name="player_sb_cat_sponsor">广告</string>
    <string name="player_sb_cat_selfpromo">自我推广</string>
    <string name="player_sb_cat_interaction">三连提醒</string>
    <string name="player_sb_cat_intro">片头</string>
    <string name="player_sb_cat_outro">片尾</string>
    <string name="player_sb_cat_preview">前情回顾</string>
    <string name="player_sb_cat_filler">离题闲聊</string>
    <string name="player_sb_cat_music_offtopic">非音乐段</string>
    <string name="player_sb_cat_exclusive_access">抢先看</string>
    <string name="player_sb_cat_chapter">章节</string>
    <string name="player_sb_cat_poi_highlight">精彩时刻</string>
    <!-- 上游以后新增了类别、而我们还没翻译时用这个兜底 -->
    <string name="player_sb_cat_unknown">广告片段</string>

    <!-- 跳过提示 -->
    <string name="player_sb_skipped">已跳过%1$s</string>
    <!-- 提示按钮：既回原位，又把这一条记进本地忽略集（26.11.14） -->
    <string name="player_sb_wrong">不准</string>
    <string name="player_sb_wrong_done">已回到%1$s，这条以后不再跳过</string>
    <!-- 整片标注（actionType=full）：26.11.14 起不再弹提示，改为顶栏标题前的胶囊，文案复用类别名 -->

    <!-- 视频详情页标题前的广告胶囊（26.11.14）：整条视频都是广告 / 只是部分片段是广告 -->
    <string name="player_sb_badge_full">广告</string>
    <string name="player_sb_badge_partial">含广告</string>

    <!-- 设置项：清除「不准」的本地忽略记录 -->
    <string name="player_sb_clear_ignored_name">清除「不准」记录</string>
    <string name="player_sb_clear_ignored_confirm">已记录 %1$d 条「不准」。清空后这些片段会重新参与自动跳过，记录无法找回。</string>
    <string name="player_sb_clear_ignored_done">已清除全部「不准」记录</string>
    <string name="player_sb_clear_ignored_empty">还没有「不准」记录</string>
</resources>
