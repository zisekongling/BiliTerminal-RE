<?xml version="1.0" encoding="utf-8"?>
<!--
  反馈与建议（26.10.09 新增）。

  与上游完全独立的一条反馈通道：内容直接 POST 到本项目自建服务器
  （server/rebiliterminal_api.py，见 TerminalApi.BASE_URL），
  不经过 B 站接口、不需要登录。

  全部控件都用工程里已有的样式（background_edittext / MaterialCardView / RotaryScrollView），
  没有引入新的 drawable 或主题属性 —— 手表端 7 套主题都要成立。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.FeedbackActivity">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_feedback"
            android:textStyle="bold" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginVertical="3dp"
            android:layout_marginEnd="8dp" />

    </RelativeLayout>

    <com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/feedback_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feedback_privacy"
                android:textSize="10sp"
                android:alpha="0.8"
                android:paddingHorizontal="4dp"
                android:paddingBottom="4dp" />

            <!-- 反馈类型：点开是 TerminalDialog.singleChoice -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/category_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/category_text"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical"
                    android:textSize="13sp"
                    tools:text="功能异常" />

            </com.google.android.material.card.MaterialCardView>

            <EditText
                android:id="@+id/content_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/background_edittext"
                android:gravity="top|start"
                android:hint="@string/feedback_content_hint"
                android:inputType="textMultiLine"
                android:minHeight="80dp"
                android:padding="8dp"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/content_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:paddingHorizontal="4dp"
                android:paddingTop="2dp"
                android:alpha="0.7"
                android:textSize="10sp"
                tools:text="0 / 4000" />

            <EditText
                android:id="@+id/contact_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/background_edittext"
                android:hint="@string/feedback_contact_hint"
                android:inputType="text"
                android:maxLength="4000"
                android:maxLines="1"
                android:padding="8dp"
                android:textSize="13sp" />

            <!-- 是否附带账号 ID：默认关，见 SettingsKeys.FEEDBACK_ATTACH_MID -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/attach_mid_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/attach_mid_text"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical"
                    android:textSize="13sp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- 是否附带应用日志：默认**不勾选**（反馈是用户主动行为，由他决定；
                 与崩溃页的默认勾选相反）。
                 26.10.16 改：原先这里是**裸 CheckBox**，夹在上下两个 MaterialCardView 之间——
                 左右与卡片内文字对不齐，而且 CheckBox 的方块本身占位、把文字又往右推了一截，
                 看起来「不属于这一列」。改成与上下一致的卡片 + 卡片内 8dp 水平边距。
                 勾选色仍读主题，不写死色值。 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/attach_log_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:orientation="vertical">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/attach_log_check"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback_attach_log"
                        android:textSize="13sp"
                        app:buttonTint="?attr/colorPrimary" />

                    <!-- 同上：本工程卡片都是「标题 + 描述」两行，只放勾选框右侧会空一大片 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:text="@string/text_activityfeedback_01"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 导出日志到文件：走 LogExporter（FileProvider + 系统分享），与提交是两条独立路径 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/export_log_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/export_log_text"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/feedback_export_log"
                    android:textSize="13sp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- 26.10.16：marginTop 由 8dp 改成 6dp —— 上面几个卡片全是 6dp，
                 只有它多出 2dp（实测 32px vs 24px），用户一眼就看出「这两个间距不一样」。 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/submit_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/feedback_submit"
                android:textSize="13sp"
                app:autoSizeMaxTextSize="13sp" />

            <TextView
                android:id="@+id/submit_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:alpha="0.85"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="已收到，反馈编号：12" />

        </LinearLayout>

    </com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>

</RelativeLayout>
