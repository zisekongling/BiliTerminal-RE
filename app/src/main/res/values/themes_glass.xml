    <!-- ============================================================================
         「玻璃质感预设」专用样式（26.11.21）
         基础覆盖层（上面那套 GlassOverlay.<X>）给的是默认档「主次分明」：
         卡片 = 背景色形态（glass_card_*），按钮 / 三连卡片 / 选中 = 主题色形态（glass_btn_bg_fill_*）。
         下面每套主题补两档：
         - ButtonStyle<X>.GlassQuiet → 「稳扎稳打」：按钮也降成卡片色，描边换柔和的 glass_stroke_*；
         - CardStyle<X>.GlassVivid   → 「晶莹剔透」：卡片也升成主色淡底，描边同样用柔和的（大面积用
           60% 亮边会像被框住的按钮）。
         再由 GlassPresetOverlay.<X>.<Steady|Crystal> 把四个 attr 与两个组件样式一并改掉。
         默认档不叠这一层，所以它对老用户零影响、零开销。
         ⚠️ 第二层的 applyStyle 会覆盖同名项，所以每个覆盖层都写全六个槽位，方便逐行对照，
            不靠「跟基础层求差集」来读。
         ============================================================================ -->

    <!-- B站粉 -->
    <style name="CardStyle.GlassVivid" parent="CardStyle.Glass">
        <item name="cardBackgroundColor">@color/glass_btn_bg_fill_pink</item>
    </style>

    <style name="ButtonStyle.GlassQuiet" parent="ButtonStyle.Glass">
        <item name="backgroundTint">@color/glass_btn_bg_quiet_pink</item>
        <item name="strokeColor">@color/glass_stroke_pink</item>
    </style>

    <!-- 稳扎稳打：卡片、动作卡片、次要按钮全部 = 卡片色；按钮换成 GlassQuiet -->
    <style name="GlassPresetOverlay.Pink.Steady" parent="">
        <item name="choiceCardColor">@color/glass_card_pink</item>
        <item name="actionCardColor">@color/glass_card_pink</item>
        <item name="actionCardStroke">@color/glass_stroke_pink</item>
        <item name="secondaryButtonTint">@color/glass_card_pink</item>
        <item name="materialCardViewStyle">@style/CardStyle.Glass</item>
        <item name="materialButtonStyle">@style/ButtonStyle.GlassQuiet</item>
    </style>

    <!-- 晶莹剔透：卡片、选择卡片、次要按钮全部 = 主色淡底；按钮保持 Glass（本来就是主题色形态） -->
