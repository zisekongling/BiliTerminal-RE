<?xml version="1.0" encoding="utf-8"?>
<!--
  终端列表型弹窗的整体布局（方案 B）。

  结构（自上而下）：
    terminal_dialog_title   —— 可选标题，带 › 前缀，主色
    terminal_dialog_list    —— 条目容器（ScrollView 包 LinearLayout）
    terminal_dialog_hint    —— 底部提示行（如「› 点空白处取消」）

  ScrollView 存在的理由：300×300 表盘上条目多了会撑破表盘，滚动把可见高度钉在预算内。
  注意 android:layout_height 写 wrap_content 只是占位：实际高度由
  util/TerminalDialog.kt 的 Sheet.prepareLayout() 按「屏幕装得下」算出来写回
  —— ScrollView 没有 android:maxHeight 属性，光靠 XML 封不了顶。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/terminal_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dialog_title_padding_h"
        android:paddingTop="@dimen/dialog_title_padding_top"
        android:paddingEnd="@dimen/dialog_title_padding_h"
        android:paddingBottom="@dimen/dialog_title_padding_bottom"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 标题与条目之间的分割线。仿设计稿方案 B 的 .d2 .hd{border-bottom}。
         颜色走 colorOnSurface 低透明度，不写死色值（跟随 7 套主题）。 -->
    <View
        android:id="@+id/terminal_dialog_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOnSurface"
        android:alpha="0.18"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/terminal_dialog_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/terminal_dialog_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!--
      按钮区。**永远在滚动区外面**（反馈 #161 / #54 / #125）：按钮跟着正文滚会被顶到
      看不见的地方，而启动时的隐私说明又不允许返回键关掉，点不到按钮 = 用户彻底卡住。
      滚动区高度不够时由 Sheet.prepareLayout() 先舍提示行再舍标题行，这里**永远不参与压缩**。

      26.11.13 起按钮改成**整行宽的纵向堆叠行**（见 TerminalDialog.Sheet.addButton）：
      原来是一行横向 LinearLayout、两个窄 TextView 右对齐，在「命中区相对视觉整体偏移」的
      设备上（#54 实测「点按钮会判定到旁边的位置」）会点到隔壁的按钮——「点取消却执行删除」
      就是这么来的。整行堆叠后横向偏移不再改变选中的是哪个动作。
      分割线放在这里而不是每行里：只画一条，且行高才是可点区域。
    -->
    <LinearLayout
        android:id="@+id/terminal_dialog_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.18" />

    </LinearLayout>

    <TextView
        android:id="@+id/terminal_dialog_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dialog_title_padding_h"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/dialog_title_padding_h"
        android:paddingBottom="11dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="11sp"
        android:alpha="0.6"
        android:visibility="gone" />

</LinearLayout>
