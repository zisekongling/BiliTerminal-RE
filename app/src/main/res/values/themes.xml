<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BiliClient" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="statusBarBackground">@color/pink_brand</item>
        <item name="android:colorForeground">@color/text_primary_dark</item>
        <item name="colorOnPrimary">@color/text_primary_dark</item>
        <item name="colorPrimary">@color/pink_brand</item>
        <item name="colorPrimaryDark">@color/pink_deep</item>
        <item name="colorPrimaryVariant">@color/pink_accent</item>
        <item name="colorAccent">@color/pink_accent</item>
        <item name="colorSecondary">@color/pink_light</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowSwipeToDismiss" tools:ignore="NewApi">true</item>

        <item name="android:textViewStyle">@style/TextViewStyle</item>
        <item name="editTextStyle">@style/EditTextStyle</item>
        <item name="materialCardViewStyle">@style/CardStyle</item>
        <item name="materialButtonStyle">@style/ButtonStyle</item>
        <item name="switchStyle">@style/SwitchCompatStyle</item>
        <item name="radioButtonStyle">@style/RadioButtonStyle</item>
        <item name="recyclerViewStyle">@style/ListStyle</item>

        <item name="colorSwitchThumbNormal">@color/text_primary_dark</item>
        <item name="colorControlActivated">@color/pink_brand</item>
        <item name="colorControlNormal">@color/color_ripple</item>
        <item name="colorControlHighlight">@color/color_ripple</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.BiliClient.Splash" parent="Theme.BiliClient">
        <item name="android:windowBackground">@drawable/splash_text</item>
    </style>

    <style name="Theme.BiliClient.Dark" parent="Theme.BiliClient">
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <style name="Theme.BiliClient.Light" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowFullscreen">true</item>
