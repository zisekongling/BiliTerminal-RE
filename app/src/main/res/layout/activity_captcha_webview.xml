<?xml version="1.0" encoding="utf-8"?>
<!--
  网页验证码页的缩放工具条（调试/兜底入口）。
  三个小按钮是固定 28dp 方块，字号是特意写死的 16sp / 9sp / 16sp；
  主题按钮样式里的「自动字号」在这里必须关掉（max 与写死值一致，正常状态不改变观感），
  并且关掉基线对齐——三颗按钮字号不同，按基线对齐会把它们上下错开。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false"
        android:background="#ffffff">

        <Button
            android:id="@+id/btnZoomOut"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="−"
            android:textSize="16sp"
            android:textColor="?attr/colorOnPrimary"
            android:background="@drawable/zoom_btn_bg"
            android:layout_marginEnd="14dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:autoSizeMaxTextSize="16sp" />

        <Button
            android:id="@+id/btnZoomReset"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="1:1"
            android:textSize="9sp"
            android:textColor="#666666"
            android:background="@android:color/transparent"
            android:layout_marginEnd="14dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:autoSizeMaxTextSize="9sp" />

        <Button
            android:id="@+id/btnZoomIn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="+"
            android:textSize="16sp"
            android:textColor="?attr/colorOnPrimary"
            android:background="@drawable/zoom_btn_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:autoSizeMaxTextSize="16sp" />

    </LinearLayout>

    <!--
      这里刻意**不**直接写 <WebView>：设备/ROM 建不出 WebView 时，inflate 阶段就会抛
      InflateException（Error inflating class android.webkit.WebView）把整个应用带崩。
      改成一个容器 + 运行期创建，创建失败只提示、不崩。判据与现场见
      docs/review/fix-progress.md §3.15。
    -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
