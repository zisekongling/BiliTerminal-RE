<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
    android:layout_marginVertical="@dimen/list_margin_vertical">

    <LinearLayout
        android:paddingHorizontal="6dp"
        android:paddingVertical="7dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!--
                参考色小方块（26.11.14）：只有「按类别配色」的行才会显示——比如「跳过设置」里
                每个广告类别那一行，色块就是它在进度条上的颜色。默认 GONE，不影响别的设置页。
            -->
            <ImageView
                android:id="@+id/setting_list_choose_swatch"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/setting_list_choose_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_cellsettinglistchoose_01"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/setting_list_choose_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/uitext_settingsadapter_001"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/setting_list_choose_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.9"
            android:text="@string/text_activityliveinfo_01"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
