<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:gravity="center"
        android:id="@+id/rankText"
        android:layout_width="36dp"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/iconView"
        android:visibility="gone"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="8dp"/>
    <!-- 反馈 #92：热搜词条过长时改为跑马灯横向滚动。
         MarqueeTextView 在 init 里读全局「文字跑马灯」开关（默认开）自己设置
         ellipsize / singleLine，所以这里不再写 ellipsize=end；
         0dp + layout_weight=1 的测量方式不变，仍是单行、heatText 不会被挤掉。 -->
    <com.RobinNotBad.BiliClient.ui.widget.MarqueeTextView
        android:textSize="16sp"
        android:textColor="?android:attr/textColorPrimary"
        android:id="@+id/keywordText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:id="@+id/heatText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
</LinearLayout>
