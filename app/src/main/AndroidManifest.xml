<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.itsaky.androidide.logsender" />

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 审计 P2-2：默认图片/视频下载目录都不再依赖它（图片默认落应用专属目录并在
         Android 10+ 发布进 MediaStore，视频默认挂 Android/media/<包名>），
         只有用户把保存路径显式改到公共目录时才需要这枚权限；
         申请入口仅保留在「设置 → 下载路径 → 授予存储权限」。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- 内置选图页（反馈 #53）在 Android 13+ 读相册用；13 以下仍是上面的 READ_EXTERNAL_STORAGE。
         不声明 READ_MEDIA_VISUAL_USER_SELECTED：Android 14 的「仅部分照片」按兼容模式处理即可。
         只在点开选图页时申请，拒绝后退回系统选择器，不影响发图。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 14 起前台服务必须声明类型，播放保活走 mediaPlayback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 审计 M12-c 收敛：
         · 移除 ACCESS_WIFI_STATE —— 原注释写「Geetest」，但极验 SDK 已删除，全库无 WifiManager 引用；
         · 移除 READ_PHONE_STATE —— 全库无 TelephonyManager/getNetworkOperator 引用，属安装即索要的敏感权限；
         · SYSTEM_ALERT_WINDOW 只服务 Debug 版 UETool 悬浮窗，已下移到 src/debug/AndroidManifest.xml，
           发布包不再声明该权限。 -->

    <application
        android:name=".BiliTerminal"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icon"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.BiliClient"
        tools:ignore="LockedOrientationActivity,RtlEnabled"
        tools:replace="android:allowBackup"
        tools:targetApi="m">
        <service android:name=".service.DownloadService"
            android:foregroundServiceType="dataSync"
            android:enabled="true"/>
        <service android:name=".service.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:enabled="true"/>

        <!-- authority 必须用 ${applicationId} 占位符：代码里是 `packageName + ".FileProvider"`，
             coexistence flavor 的包名带 .coexist 后缀，写死会让共存版的下载安装/分享直接崩。 -->
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 缓存/下载的本地视频交给外部播放器（凉腕等）时的只读共享通道。
             FileProvider 的根是编译期资源、只能覆盖「主卷」（androidx 只取
             getExternalMediaDirs()[0] 等数组第一项）；用户把缓存路径改到外置 SD 卡后
             路径形如 /storage/XXXX-XXXX/Android/media/<包名>/...，FileProvider 会抛
             IllegalArgumentException: Failed to find configured root 把页面带崩。
             这个 provider 在运行时按「所有存储卷」算根，细节见 util/LocalFileProvider.kt。 -->
        <provider android:name=".util.LocalFileProvider"
            android:authorities="${applicationId}.LocalFileProvider"
            android:exported="false"
            android:grantUriPermissions="true" />

