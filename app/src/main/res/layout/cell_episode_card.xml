<?xml version="1.0" encoding="utf-8"?>
<!-- 番剧选集卡片（两行）：第一行"正在播放"声波图标 + 集标题 + 角标，第二行长标题。
     宽度固定 128dp：横向列表里靠固定宽度保持节奏一致，不随标题长短跳。
     选中态只改文字/图标颜色，卡片底色不动（底色随主题走，见 ColorScheme/CornersStyle）。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/episode_card"
    android:layout_width="128dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="3dp"
    android:layout_marginEnd="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/card_padding"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:contentDescription="@string/a11y_episode_playing"
                android:id="@+id/episode_playing"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_episode_playing"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/episode_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="@dimen/text_subtitle"
                tools:text="第 5 话" />

            <TextView
                android:id="@+id/episode_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:textSize="@dimen/text_caption"
                android:visibility="gone"
                tools:text="会员"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/episode_title_long"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            tools:text="各自的答案"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
