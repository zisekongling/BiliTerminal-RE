<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:background="@color/card_dark_secondary">

    <TextView
        android:id="@+id/btnUpdateDanmaku"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="更新弹幕"
        android:textSize="13sp"
        android:textColor="@color/pink_light"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="8dp"
        android:background="@color/divider_dark" />

    <LinearLayout
        android:id="@+id/layoutQuality"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="切换分辨率"
            android:textSize="13sp"
            android:textColor="@color/pink_light" />

        <TextView
            android:id="@+id/textCurrentQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前"
            android:textSize="10sp"
            android:alpha="0.5" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="8dp"
        android:background="@color/divider_dark" />

    <TextView
        android:id="@+id/btnMoveVideo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="移动"
        android:textSize="13sp"
        android:textColor="@color/pink_light"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="8dp"
        android:background="@color/divider_dark" />

    <TextView
        android:id="@+id/btnViewDetail"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="查看详情"
        android:textSize="13sp"
        android:textColor="@color/pink_light"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="8dp"
        android:background="@color/divider_dark" />

    <TextView
        android:id="@+id/btnCancelSettings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="取消"
        android:textSize="13sp"
        android:alpha="0.65"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />
</LinearLayout>