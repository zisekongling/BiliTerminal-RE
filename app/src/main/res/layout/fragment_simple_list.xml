<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/loading_2233"
        android:visibility="gone" />

    <!-- 空态：列表为空是正常状态，不放 loading_2233_error 报错插画，
         否则会被误认成"加载失败"。确属加载失败时由 MsgUtil.err 弹提示。 -->
    <TextView
        android:id="@+id/emptyTip"
        android:padding="@dimen/space_xl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="啥都木有~"
        android:textAlignment="center"
        android:gravity="center"
        android:visibility="gone" />
</FrameLayout>