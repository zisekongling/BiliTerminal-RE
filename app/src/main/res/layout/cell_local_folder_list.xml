<?xml version="1.0" encoding="utf-8"?>
<!-- 本地缓存·独立文件夹列表页的卡片（26.11.13）。
     结构照收藏夹卡片 cell_favorite_folder_list.xml：左侧 16:9 封面、右侧上下两行（名称 / 视频数）。
     封面取夹内第一条缓存视频目录里的 cover.png；空文件夹由代码塞占位图（@mipmap/placeholder）。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/list_margin_vertical"
    android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:contentDescription="@null"
            android:id="@+id/img_cover"
            android:importantForAccessibility="no"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="10dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toStartOf="@+id/guide_cover_end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_cover_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.4" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_title_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="@dimen/text_body"
            app:layout_constraintBottom_toTopOf="@+id/guide_title_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guide_cover_end" />

        <TextView
            android:id="@+id/text_itemcount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:text="@string/text_cellvideofolder_03"
            android:textSize="@dimen/text_caption"
            app:layout_constraintStart_toEndOf="@+id/icon_count"
            app:layout_constraintTop_toTopOf="@+id/guide_title_bottom" />

        <ImageView
            android:contentDescription="@null"
            android:id="@+id/icon_count"
            android:importantForAccessibility="no"
            android:layout_width="@dimen/icon_sm"
            android:layout_height="@dimen/icon_sm"
            android:alpha="0.7"
            app:srcCompat="@drawable/icon_folder"
            app:layout_constraintBottom_toBottomOf="@+id/text_itemcount"
            app:layout_constraintStart_toStartOf="@+id/text_title"
            app:layout_constraintTop_toTopOf="@+id/text_itemcount" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
