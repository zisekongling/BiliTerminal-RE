<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
    android:layout_marginVertical="8dp">

    <View
        android:id="@+id/left_line"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:background="@color/theme_color"
        app:layout_constraintTop_toTopOf="@id/text_blockquote"
        app:layout_constraintBottom_toBottomOf="@id/text_blockquote"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/text_blockquote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:background="@color/blockquote_bg"
        android:padding="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/left_line"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>