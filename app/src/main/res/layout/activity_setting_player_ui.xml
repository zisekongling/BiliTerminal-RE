<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.settings.SettingPlayerUiActivity">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:lines="1"
            android:text="@string/pagename_setting_player_ui"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <TextView
            android:id="@+id/btnFull"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="@string/setting_player_ui_full"
            android:textSize="12sp" />

    </RelativeLayout>

    <!-- 一类「点一下改一下」的设置：一列一节，一格一行（见 SettingPlayerUiActivity.rebuildRows） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contentList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top"
        android:paddingHorizontal="@dimen/activity_padding_horizontal" />
    <!-- 卡片打开时铺满列表区当遮罩：点空白处就收起卡片 -->
    <View
        android:id="@+id/cardScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top"
        android:background="@color/card_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- 点一行后从下半屏滑出来的卡片：换按钮 / 挪位置 / 选按钮 / 那组设置，复用 SettingsAdapter -->
    <LinearLayout
        android:id="@+id/cardPanel"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="4dp"
        android:background="@drawable/background_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/cardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cardList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</RelativeLayout>
