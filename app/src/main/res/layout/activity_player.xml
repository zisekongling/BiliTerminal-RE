<?xml version="1.0" encoding="utf-8"?>
<!--
    本页由原生 Activity（android:Theme.Black）承载，布局走系统 inflater，AppCompat 的控件工厂
    与 app:srcCompat 都不生效；矢量图必须用 VectorImageButton / VectorImageView 自读 app:srcCompat
    （原因见 ui/widget/VectorImageView.kt 的类注释）。新增图标按钮请沿用这两个类。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:keepScreenOn="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.player.PlayerActivity"
    android:id="@+id/root_layout"
    android:clipChildren="false"
    android:clipToPadding="false">


    <RelativeLayout
        android:id="@+id/videoArea"
        android:layout_width="1px"
        android:layout_height="1px"
        android:layout_centerInParent="true" />


    <master.flame.danmaku.ui.widget.DanmakuView
        android:id="@+id/sv_danmaku"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:id="@+id/audio_only_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/audio_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:maxWidth="220dp"
                android:text="@string/settingtext_settingsindex_051"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/audio_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:maxWidth="220dp"
                android:text="@string/text_activityplayer_08"
                android:textColor="#99ffffff"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </RelativeLayout>

    <!--
        字幕：必须放在 control_layout 之外，否则锁定时整条控制栏置 GONE 会把字幕一起藏掉
        （用户反馈的「锁定后不显示字幕」）。位置与原先「进度文字之上」等价：底边离屏幕底 76dp
        ＝底部控制栏 59dp + 进度文字约 17dp。
    -->
    <TextView
        android:id="@+id/text_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="76dp"
        android:alpha="0.8"
        android:background="@drawable/background_grey_cardview"
        android:gravity="center"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:text="@string/text_default_subtitle"
        android:textSize="11sp"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/control_layout"
        android:gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/swipe_seek_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottom_control"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="6dp"
            android:background="@drawable/background_grey_cardview"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/swipe_seek_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#000000"
                android:shadowDx="1.0"
                android:shadowDy="1.0"
                android:shadowRadius="2.0"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="01:23 / 05:00 (27%)" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:gravity="start"
            android:text="@string/text_default_progress"
            android:alpha="0.8"
            android:textSize="11sp"
            android:layout_above="@id/bottom_control" />

        <TextView
            android:id="@+id/text_online"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottom_control"
            android:alpha="0.8"
            android:gravity="end"
            android:paddingEnd="2dp"
            android:text="@string/text_default_online"
            android:textAlignment="textEnd"
            android:textSize="11sp" />

        <RelativeLayout
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#348A8A8A"
            android:paddingHorizontal="8dp"
            android:layout_alignParentTop="true">

            <com.RobinNotBad.BiliClient.ui.widget.MarqueeTextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:layout_toStartOf="@+id/clock_layout"
                app:drawableStartCompat="@drawable/arrow_back"
                android:text="@string/pagename_player"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/clock_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:orientation="vertical">

                <com.RobinNotBad.BiliClient.ui.widget.BatteryView
                    android:id="@+id/battery"
                    android:layout_width="16dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="2dp" />

                <com.RobinNotBad.BiliClient.ui.widget.TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="8sp"
                    tools:ignore="SmallSp" />
            </LinearLayout>
        </RelativeLayout>


        <LinearLayout
            android:id="@+id/bottom_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#348A8A8A"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!--
                进度条保持 26.11.02 的 20dp 高：26.11.07 把热区放大到 48dp（@dimen/touch_min）+ 上下
                各 14dp 内边距，波形本身没变，只是把底栏从 59dp 撑到 94dp —— 大屏上整条底栏看起来被
                「拉粗」，与 11.02 差别明显。热区放大已在 26.11.08 整批回退（用户口径：全设备统一回
                11.02 尺寸），要恢复请连字幕上下边距（PlayerActivity 的 subtitle 边距常量）一起改。
            -->
            <com.RobinNotBad.BiliClient.ui.widget.HighEnergyProgressBar
                android:id="@+id/videoprogress"
                style="@style/Widget.AppCompat.SeekBar"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:progressTint="?attr/colorPrimary"
                android:secondaryProgressTint="@color/player_progress_bg"
                android:thumbOffset="8dp"
                tools:targetApi="lollipop" />

            <!--
                底部组展开条：组按钮点开后，组内按钮排在这里（在按钮行上方）。
                放在 bottom_control 里而不是 bottom_buttons 里，是因为 bottom_buttons 用
                wrap_content 的 RelativeLayout 承载按钮行，一旦里面有贴底的子项它就会撑满父容器。
            -->
            <HorizontalScrollView
                android:id="@+id/bottom_group_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/background_edittext"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/bottom_group_slots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp" />
            </HorizontalScrollView>

            <!--
                底部按钮行（26.11.06 起可自定义）：左槽位 + 播放/暂停（不可自定义）+ 右槽位，各最多 3 格。
                按钮本体都在最外层隐藏的 button_pool 里，运行时由 PlayerButtonSlots 搬进来。

                **整行作为一个整体居中**（26.11.08 回退）：26.11.07 把两侧槽位改成 `weight="1"` +
                `fillViewport="true"` 平分屏幕宽度，宽屏上两侧的不可见视口各占半屏（411dp 竖屏 →
                每侧 178dp），按钮簇被推到离播放键很远的位置，看起来就是「按钮被摊开、底栏错位」。
                现在按 11.02 的口径：整行 width=wrap_content，外面套一条 fillViewport 的滚动条 ——
                按钮少时靠 `gravity="center"` 整体居中，按钮多到装不下时整行横向滚动，不会两头被裁。
            -->
            <RelativeLayout
                android:id="@+id/bottom_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <HorizontalScrollView
                    android:id="@+id/bottom_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/bottom_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/bottom_left_slots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical|end"
                            android:orientation="horizontal" />

                        <!--
                            32dp × 37dp、无内边距，与 26.11.02 完全一致（图标 fitCenter 铺满格子，
                            圆形底盘直径 ≈ 32dp）。26.11.07 把格子放大到 44dp 时加了 6/3 内边距让图标
                            保持原尺寸，26.11.08 回退格子尺寸却漏删了内边距 —— 图标只剩 20×31dp，
                            用户报「暂停按钮变小了」。**别再往里加内边距**，要放大热区就连格子一起改。
                        -->
                        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
                            android:contentDescription="@string/setting_player_ui_label_play"
                            android:id="@+id/button_video"
                            android:layout_width="32dp"
                            android:layout_height="37dp"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:adjustViewBounds="true"
                            android:background="?android:attr/selectableItemBackground"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/btn_player_play" />

                        <LinearLayout
                            android:id="@+id/bottom_right_slots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical|start"
                            android:orientation="horizontal" />
                    </LinearLayout>
                </HorizontalScrollView>

            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/right_control"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottom_control"
            android:gravity="center"
            android:layout_below="@+id/top"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="4dp"
            android:orientation="horizontal">


            <!--
                组的展开条（26.11.06）：槽位里的「组」渲染成一个更多按钮，点开后组内按钮排在
                竖列左侧这条横条上，同一侧同时只展开一组。原来这里是固定的「第二排」九个按钮，
                现在全部收进 button_pool，位置由用户布局决定。
            -->
            <HorizontalScrollView
                android:id="@+id/right_group_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/background_edittext"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/right_group_slots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp" />

            </HorizontalScrollView>

            <!-- 右列槽位：最多 5 格，运行时按用户布局填 -->
            <LinearLayout
                android:id="@+id/right_column_slots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical" />


        </LinearLayout>

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/a11y_player_debug"
            android:id="@+id/btn_debug"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_alignParentLeft="true"
            android:layout_above="@+id/bottom_control"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/icon_debug"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/loading_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.RobinNotBad.BiliClient.ui.widget.VectorImageView
                android:contentDescription="@null"
                android:id="@+id/circle"
                android:importantForAccessibility="no"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/loading_text0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:shadowColor="#000000"
                android:shadowDx="2.0"
                android:shadowDy="0.0"
                android:shadowRadius="3.0"
                android:text="@string/a11y_activityloading_01"
                android:textAlignment="center"
                android:textColor="#DDDDDD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/loading_text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:shadowColor="#000000"
                android:shadowDx="2.0"
                android:shadowDy="0.0"
                android:shadowRadius="3.0"
                android:text="OwO"
                android:textAlignment="center"
                android:textColor="#DDDDDD"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_speed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#50000000"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:shadowColor="#000000"
                android:shadowDx="2.0"
                android:shadowDy="0.0"
                android:shadowRadius="3.0"
                android:text="@string/text_activityplayer_07"
                android:textAlignment="center"
                android:textColor="#DDDDDD"
                android:textSize="14sp"
                app:layout_constraintBottom_toTopOf="@+id/seekbar_speed" />

            <SeekBar
                android:id="@+id/seekbar_speed"
                style="@style/Widget.AppCompat.SeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="26dp"
                android:minHeight="@dimen/touch_min"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:indeterminate="false"
                android:max="7"
                android:progress="2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/text_newspeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:shadowColor="#000000"
                android:shadowDx="2.0"
                android:shadowDy="0.0"
                android:shadowRadius="3.0"
                android:text="1.0x"
                android:textAlignment="center"
                android:textColor="#DDDDDD"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/seekbar_speed" />

        </LinearLayout>


    </RelativeLayout>


    <TextView
        android:id="@+id/showsound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:shadowColor="#000000"
        android:shadowDx="2.0"
        android:shadowDy="0.0"
        android:shadowRadius="3.0"
        android:text="@string/text_activityplayer_06"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!--
        「无极调音」弹层：0~100% 软件增益（ijk setVolume）。与 layout_speed 同一套玩法：
        点空白处关闭、无操作自动收起。放在 control_layout 之外是有意的：控制栏自动隐藏后
        这个弹层也得单独收掉，塞进控制栏会被一起置 GONE（看不到调节反馈）。
        手表窄屏下用 match_parent 铺满、靠 gravity 居中，SeekBar 上下各留 10dp padding 保证手指可点。
    -->
    <LinearLayout
        android:id="@+id/layout_volume"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#50000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_volume_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shadowColor="#000000"
            android:shadowDx="2.0"
            android:shadowDy="0.0"
            android:shadowRadius="3.0"
            android:textAlignment="center"
            android:textColor="#DDDDDD"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seekbar_volume"
            style="@style/Widget.AppCompat.SeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="6dp"
            android:minHeight="@dimen/touch_min"
            android:indeterminate="false"
            android:max="100"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:progress="100" />

        <TextView
            android:id="@+id/text_newvolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shadowColor="#000000"
            android:shadowDx="2.0"
            android:shadowDy="0.0"
            android:shadowRadius="3.0"
            android:textAlignment="center"
            android:textColor="#DDDDDD"
            android:textSize="14sp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#70000000"
        android:visibility="gone">


        <LinearLayout
            android:id="@+id/subtitle_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/subtitle_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="3dp"
                android:text="@string/text_activityplayer_05"
                android:textSize="14sp" />

            <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                android:id="@+id/subtitle_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="3dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/cell_subtitle" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/danmaku_send_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="3dp"
                android:text="@string/text_activityplayer_04"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/danmaku_send_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:hint="@string/hint_activityplayer_03"
                android:maxLength="100"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="#88ffffff" />

            <Button
                android:id="@+id/danmaku_send"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginHorizontal="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/background_card_borderless"
                android:gravity="center"
                android:text="@string/btn_send" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_selector_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="6dp"
            android:layout_marginBottom="56dp"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/page_selector_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="3dp"
                android:text="@string/text_activityplayer_02"
                android:textSize="14sp" />

            <!-- 嵌套层的进出入口：在根目录层显示「进入分P / 进入合集」，进了层显示「← 返回主合集」。
                 两个方向互斥（要么在层外、要么在层内），所以共用同一行。 -->
            <TextView
                android:id="@+id/page_selector_nest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:paddingHorizontal="3dp"
                android:paddingVertical="6dp"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                android:id="@+id/page_selector_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="3dp"
                android:maxHeight="240dp"
                android:orientation="vertical" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/quality_selector_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="6dp"
            android:layout_marginBottom="56dp"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/quality_selector_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="3dp"
                android:text="@string/text_activityliveinfo_10"
                android:textSize="14sp" />

            <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                android:id="@+id/quality_selector_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="3dp"
                android:maxHeight="240dp"
                android:orientation="horizontal" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/viewpoint_selector_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/viewpoint_selector_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="3dp"
                android:text="@string/text_activityplayer_01"
                android:textSize="14sp" />

            <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                android:id="@+id/viewpoint_selector_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="3dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/cell_episode" />

        </LinearLayout>

    </RelativeLayout>

    <!--
        可自定义按钮的池子（26.11.06）。这里放的是**按钮本体**，永远 GONE 不出现在画面上：
        播放器里的状态、监听器全都写在它们身上（`PlayerActivity.btn_danmaku` 等字段指的也是这里），
        视觉位置由 `player/PlayerButtonSlots.kt` 按用户布局把它们搬进四个槽位容器。
        所以增删按钮不需要改这段结构，只要保证 id 不变。
        「更多」不在这里：它是组槽位在运行时现画的按钮。
    -->
    <LinearLayout
        android:id="@+id/button_pool"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/setting_player_btn_quality"
            android:id="@+id/button_quality"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/icon_menu" />

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/setting_player_btn_sound_cut"
            android:id="@+id/button_sound_cut"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitCenter"
            android:src="@mipmap/soundcut" />

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/setting_player_btn_sound_add"
            android:id="@+id/button_sound_add"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitCenter"
            android:src="@mipmap/soundadd" />

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/setting_player_btn_page_selector"
            android:id="@+id/button_page_selector"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/icon_folder"
            android:visibility="gone" />

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/setting_player_btn_danmaku_send"
            android:id="@+id/danmaku_send_btn"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/send" />

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/setting_player_btn_subtitle"
            android:id="@+id/subtitle_btn"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitXY"
            android:src="@mipmap/subtitle_off" />

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/setting_player_btn_loop"
            android:id="@+id/loop_btn"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitXY"
            android:src="@mipmap/loopoff" />

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/setting_player_btn_audio_only"
            android:id="@+id/audio_only_btn"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/icon_play_16"
            android:visibility="gone" />

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/setting_player_btn_auto_next"
            android:id="@+id/auto_next_btn"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/icon_auto_next_off"
            android:visibility="gone" />

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/setting_player_btn_viewpoint"
            android:id="@+id/viewpoint_btn"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/icon_folder"
            android:visibility="gone" />

        <TextView
            android:id="@+id/video_info_btn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/uitext_videoinfoactivity_002"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!--
            QQ#9 精确空降：点开输入时间点直接跳。
            手表上拖进度条很难停准，这里给一个「输入 mm:ss」的入口；
            直播没有时间点概念，显隐由 onPrepared 的直播分支统一控制。
            26.11.06 起按钮画图标（lucide clock-fading），文字只留作无障碍描述与输入框标题。
        -->
        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:id="@+id/jump_time_btn"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/text_player_jump_to_time"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/icon_player_clock_fading"
            android:visibility="gone" />

        <!--
            连播队列按钮（批次 2）：有队列时点一下切模式（顺序/倒序/随机/单曲），
            没有队列但知道 UP 主时点一下懒加载 UP 主投稿；长按总是尝试换成 UP 主投稿队列。
            显隐由 updateQueueModeButton() 统一算。
            26.11.06 起按钮画图标（lucide corner-down-right），当前模式写进 contentDescription。
        -->
        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:id="@+id/queue_mode_btn"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/player_queue_btn_label"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/icon_player_corner_down_right"
            android:visibility="gone" />

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/setting_player_btn_danmaku"
            android:id="@+id/danmaku_btn"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitXY"
            android:src="@mipmap/danmakuoff" />

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:contentDescription="@string/setting_player_btn_rotate"
            android:id="@+id/rotate_btn"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitXY"
            android:src="@mipmap/rotate" />

        <com.RobinNotBad.BiliClient.ui.widget.VectorImageButton
            android:id="@+id/lock_btn"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/desc_player_lock_locked"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/icon_player_unlock" />

        <TextView
            android:id="@+id/text_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingVertical="5dp"
            android:shadowColor="#000000"
            android:shadowDx="2.0"
            android:shadowDy="0.0"
            android:shadowRadius="3.0"
            android:text="x 1.0"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!--
            G02 ±N 秒快退 / 快进（26.11.13，对应兄弟分支 cyq 的 player_seek_buttons）：
            文字按钮，步长可配置（见 PlayerSeekStepPolicy），文字由 PlayerActivity 按设置写进
            text（如 «10s / 10s»）。与倍速一样算「文字类」槽位：宽度交给文字自己、高度用格子高。
            默认不摆进可见槽位，收在右侧「更多」组里，老用户升级后布局不变。
        -->
        <TextView
            android:id="@+id/text_seek_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/setting_player_btn_seek_back"
            android:paddingVertical="5dp"
            android:shadowColor="#000000"
            android:shadowDx="2.0"
            android:shadowDy="0.0"
            android:shadowRadius="3.0"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_seek_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/setting_player_btn_seek_forward"
            android:paddingVertical="5dp"
            android:shadowColor="#000000"
            android:shadowDx="2.0"
            android:shadowDy="0.0"
            android:shadowRadius="3.0"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

    <!--
        播放页触摸锁定（防误触）：锁定时全屏的 lock_overlay 盖住所有控制元素并吞掉触摸，
        只有它上面的 lock_btn 可以点。两个兄弟节点必须放在最外层最后，才能压住 card_bg 等弹层。
    -->
    <View
        android:id="@+id/lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!--
        锁定期间的锁定按钮落脚点（26.11.06）。锁定会把 control_layout 整条藏掉，而右列 / 底部
        两区的槽位就在 control_layout 里面——用户把锁定按钮摆到那儿的话，锁屏后按钮会跟着消失、
        解不开锁。所以锁定时 PlayerActivity 把 lock_btn 临时搬到这里，按它原来所在的那一区贴边
        显示；解锁后再按用户布局摆回去。必须排在 lock_overlay 之后才能压在遮罩上面。
    -->
    <FrameLayout
        android:id="@+id/lock_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!--
        左侧槽位列（26.11.06 起可自定义）：与 right_control 的竖列对称（同单元格、同 4dp 边距）。
        右列的上下锚点在 control_layout 内部，root 层够不到，所以中线对齐由
        PlayerActivity.alignLeftControlToRight() 在运行时用 translationY 补。
        锁定后 control_layout 整体隐藏，这一列仍留着锁定按钮；倍速文字由锁定逻辑单独隐藏。
        组的展开条在列的右边：点更多按钮后组内按钮横向排在那一侧。
    -->
    <LinearLayout
        android:id="@+id/left_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/left_column_slots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical" />

        <HorizontalScrollView
            android:id="@+id/left_group_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/background_edittext"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/left_group_slots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp" />
        </HorizontalScrollView>

    </LinearLayout>

</RelativeLayout>
