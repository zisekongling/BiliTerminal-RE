<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_default"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_down" />

        <!-- 时钟必须是 @id/top 的直系子 View，与 activity_simple_refresh.xml 等其余布局一致：
             BaseActivity.setRound() 的圆屏适配是靠给时钟加 RelativeLayout.CENTER_HORIZONTAL
             把它挪到顶栏正中的。此前这里套了一层 menuArea(LinearLayout)，时钟拿到的是
             LinearLayout.LayoutParams，加不了 RelativeLayout 规则 → 圆屏模式下时钟仍被
             alignParentRight 钉在最右，被圆盘切掉（26.11.01 修复）。 -->
        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp" />

    </RelativeLayout>

    <!-- 列表区 + 底部"正在加载…／没有更多了"状态条（不用 ConcatAdapter，理由见 activity_simple_refresh.xml） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top"
        android:orientation="vertical">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/loadMoreTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone"
            tools:text="正在加载…" />

    </LinearLayout>

    <!-- 空态：列表为空是正常状态，不放 loading_2233_error 报错插画，
         否则会被误认成"加载失败"。确属加载失败时由 MsgUtil.err 弹提示。 -->
    <TextView
        android:id="@+id/emptyTip"
        android:padding="@dimen/space_xl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/text_list_empty"
        android:textAlignment="center"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

</RelativeLayout>
