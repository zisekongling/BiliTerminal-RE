        <activity
            android:name=".activity.GetIntentActivity"
            android:exported="true"
            android:label="@string/label_activity_no_21"
            android:screenOrientation="locked">
            <!-- 审计 P2-7：http/https 只接收 B 站域。
                 之前只声明 scheme、不写 host，等于把本应用注册成任意网页的打开方式：
                 用户点任何链接都可能弹本应用，且外部可用任意 URL 拉起本页。
                 bilibili:// 是自定义 scheme，仍单独放行（页面内再做 host 校验）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="bilibili" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- 通配符只匹配子域，裸域要单独写 -->
                <data
                    android:host="bilibili.com"
                    android:scheme="http" />
                <data
                    android:host="*.bilibili.com"
                    android:scheme="http" />
                <data
                    android:host="b23.tv"
                    android:scheme="http" />
                <data
                    android:host="bilibili.com"
                    android:scheme="https" />
                <data
                    android:host="*.bilibili.com"
                    android:scheme="https" />
                <data
                    android:host="b23.tv"
                    android:scheme="https" />
            </intent-filter>
        </activity>
