<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/card_dark">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="文件夹设置"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary_dark"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="重命名文件夹"
        android:textSize="12sp"
        android:textColor="@color/text_secondary_dark"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/editRename"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:background="@drawable/edit_bg"
        android:maxLength="30"
        android:singleLine="true"
        android:inputType="text"
        android:textColor="@color/text_primary_dark"
        android:textColorHint="@color/text_tertiary_dark" />

    <TextView
        android:id="@+id/textRenameError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/status_error"
        android:textSize="11sp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="end">

        <TextView
            android:id="@+id/btnDisband"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="20dp"
            android:gravity="center"
            android:text="拆散文件夹"
            android:textSize="13sp"
            android:textColor="@color/status_error"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="20dp"
            android:gravity="center"
            android:text="取消"
            android:textSize="13sp"
            android:alpha="0.65"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnConfirmRename"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="20dp"
            android:gravity="center"
            android:text="确认重命名"
            android:textSize="13sp"
            android:textColor="@color/pink_light"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>