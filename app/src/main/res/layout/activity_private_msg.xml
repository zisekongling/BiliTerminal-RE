<?xml version="1.0" encoding="utf-8"?>
<!--
  顶栏不铺底色、列表排在顶栏下方（而不是全屏列表 + 不透明顶栏盖在上面）：
  原先的 ?android:attr/colorBackground 在开启弥散光晕时会把顶部最亮的那块光晕盖成一条纯色横带，
  而且经典终端下它取主题 XML 的 #1B1B24，与运行时背景 #000000 本就不一致。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent">

    <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
        android:id="@+id/msg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="60dp" />

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_private_message"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>


    <!--
      底部只留一个铺满的「写私信」按钮：点开写评论页的私信模式，输入框、表情、图片、换行、发送
      全部复用评论区那一套。原来这一行是「输入框 + 表情/图片/发送三个 38dp 图标」，
      宽度还得按权重分给输入框（#157），手表上真正好按的其实是一个整行按钮。
      按钮保留输入行的滚动收起动画（PrivateMsgActivity 按 writeMsgBtn 做动画）。
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/write_msg_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/activity_padding_horizontal"
        android:layout_marginEnd="@dimen/activity_padding_horizontal"
        android:layout_marginBottom="4dp"
        android:text="@string/pagename_write_private" />
</RelativeLayout>
