<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_about"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView
        android:id="@+id/scrollView"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:layout_below="@id/top">

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingBottom="20dp">

            <ImageView
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_height="65dp"
                android:layout_width="65dp"
                android:src="@mipmap/icon"
                android:layout_marginTop="20dp"
                android:layout_gravity="center" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginTop="2dp"
                android:textSize="16sp"
                android:gravity="center"
                android:text="@string/app_name" />

            <com.RobinNotBad.BiliClient.ui.widget.MarqueeTextView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:textSize="12sp"
                android:alpha="0.85"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="6dp"
                android:text="@string/about_description"
                android:singleLine="true"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/version_name_card"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:layout_width="0dp"
                    android:layout_marginEnd="2dp">

                    <TextView
                        android:layout_height="match_parent"
                        android:layout_width="wrap_content"
                        android:textSize="11sp"
                        android:alpha="0.9"
                        android:text="@string/text_activitysettingabout_07"
                        android:padding="3dp"
                        android:id="@+id/app_version"
                        android:layout_gravity="center"
                        android:gravity="center" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/version_code_card"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:layout_weight="0.5"
                    android:layout_marginStart="2dp">

                    <TextView
                        android:layout_height="match_parent"
                        android:layout_width="wrap_content"
                        android:textSize="11sp"
                        android:alpha="0.9"
                        android:padding="3dp"
                        android:text="@string/text_activitysettingabout_06"
                        android:id="@+id/app_version_code"
                        android:layout_gravity="center"
                        android:gravity="center" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/debug_tip"
                android:layout_marginTop="4dp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="1dp">

                <TextView
                    android:layout_height="match_parent"
                    android:layout_width="wrap_content"
                    android:textSize="11sp"
                    android:padding="3dp"
                    android:alpha="0.85"
                    android:text="@string/text_about_test_version"
                    android:layout_gravity="center"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/cell_divider" />

            <!-- 仓库地址（26.11.08）：用户要求放在「官网」上面（首屏就能看到并点开）。
                 地址本身就是要点的超链接，代码里挂 LinkClickableSpan（见 AboutActivity），
                 所以这里不做「整行入口 + 箭头」那套样式。
                 地址写在 strings.xml 的 about_repo_url，换仓库只改那一处。 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/repo_entry"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/about_repo_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/repo_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/about_repo_url"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.8"
                        android:gravity="center"
                        android:text="@string/about_repo_tip"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 官网 + 交流群。上面紧挨着仓库卡，必须留出间距，否则两张卡片的底色连成一片。 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="6dp"
                    android:gravity="center"
                    android:text="@string/about_group"
                    android:textSize="12sp" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/author_words"
                android:layout_marginTop="6dp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/settingtext_aboutactivity_012"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginVertical="2dp"
                        android:gravity="center"
                        android:text="@string/about_say"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="6dp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/donate_title"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginVertical="2dp"
                        android:gravity="center"
                        android:text="@string/about_group_tip"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/about_wearbili"
                    android:textSize="11sp" />

            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/cell_divider" />

            <!-- 赞赏：点开是一张收款码。走图片查看器（ImageViewerActivity）而不是播放器：
                 二维码在手表上得能双指放大才看得清、扫得动。图片地址在 strings.xml 的 about_donate_url。 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/donate_qr_entry"
                android:layout_marginBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/about_donate_entry"
                    android:textAlignment="textStart"
                    android:textSize="13sp"
                    app:drawableEndCompat="@drawable/arrow_forward" />
            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/cell_divider" />

            <!-- 「捐赠列表」入口按用户要求（26.11.06）先隐藏：只藏入口，页面 SponsorActivity 与
                 AboutActivity 里的点击绑定都留着，恢复时删掉下一行的 android:visibility="gone" 即可。 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sponsor_list"
                android:layout_marginBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/pagename_sponsoractivity_001"
                    android:textAlignment="textStart"
                    android:textSize="13sp"
                    app:drawableEndCompat="@drawable/arrow_forward" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="6dp"
                    android:orientation="vertical">

                    <!-- 三列：RE 版主要开发者 → 原版主要开发者 → 联合开发者。
                         「紫色空灵」是 RE 版（当前这版）的主要开发者，单独成一列放最前；
                         他的身份改由列名表达，卡片简介位因此留空（原 about_dev_trae 已复用为列名）。 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/about_dev_trae"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/developer_re_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="6dp"
                        android:text="@string/text_activitysettingabout_05"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/developer_main_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="6dp"
                        android:text="@string/text_activitysettingabout_04"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/developer_joint_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/cell_divider" />

            <com.google.android.material.card.MaterialCardView
                android:layout_height="wrap_content"
                android:layout_width="match_parent">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textSize="14sp"
                        android:text="@string/text_activitysettingabout_03"
                        android:layout_gravity="center" />

                    <TextView
                        android:id="@+id/current_update_title"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="@string/text_activitysettingabout_02"
                        android:layout_marginTop="6dp"
                        android:layout_gravity="center" />

                    <TextView
                        android:id="@+id/updatelog_view"
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:layout_marginBottom="2dp"
                        android:layout_gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/history_log_entry"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/pagename_updatehistoryactivity_001"
                    android:textAlignment="textStart"
                    android:textSize="13sp"
                    app:drawableEndCompat="@drawable/arrow_forward" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/opensource_entry"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/pagename_opensource"
                    android:textAlignment="textStart"
                    android:textSize="13sp"
                    app:drawableEndCompat="@drawable/arrow_forward" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:id="@+id/toUncle"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textSize="14sp"
                        android:text="@string/text_activitysettingabout_01"
                        android:layout_gravity="center" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:layout_marginVertical="2dp"
                        android:text="@string/about_to_uncle"
                        android:layout_gravity="center" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--
              自建反馈通道的入口（26.10.09 新增）。
              挂在关于页而不是新增一个菜单项：菜单结构对老用户是缓存的，新加的分组不会自动出现，
              而关于页是所有版本都有的固定入口。
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/feedback_entry"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/feedback_entry_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/feedback_entry_desc"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/about_trailer_feedback"
                    android:textSize="11sp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>

</RelativeLayout>
